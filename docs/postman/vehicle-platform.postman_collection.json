    {
      "name": "2. Vitrine (serviço de venda)",
      "description": "Listagem pública, isolada no serviço de venda e servida pelo banco dele (sales_db).",
      "item": [
        {
          "name": "Veículos à venda (mais barato primeiro)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sales_url}}/vehicles/available?page=0&size=100",
              "host": [
                "{{sales_url}}"
              ],
              "path": [
                "vehicles",
                "available"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 - vitrine\", () => pm.response.to.have.status(200));",
                  "const content = pm.response.json().content;",
                  "const ids = content.map(v => v.id);",
                  "const prices = content.map(v => Number(v.price));",
                  "const corolla = pm.collectionVariables.get(\"corolla_id\");",
                  "const onix = pm.collectionVariables.get(\"onix_id\");",
                  "pm.test(\"Corolla e Onix chegaram ao serviço de venda (sincronizados por HTTP)\", () => {",
                  "    pm.expect(ids).to.include(corolla);",
                  "    pm.expect(ids).to.include(onix);",
                  "});",
                  "pm.test(\"Ordenada do mais barato para o mais caro\", () => {",
                  "    pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "    pm.expect(ids.indexOf(onix)).to.be.below(ids.indexOf(corolla));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Edição (serviço principal)",
      "description": "A edição também é repassada ao serviço de venda.",
      "item": [
