            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"year\": 2022,\n  \"color\": \"Prata\",\n  \"price\": 118000.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 - veículo editado\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Novo preço gravado\", () => pm.expect(Number(pm.response.json().price)).to.eql(118000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Vitrine com o novo preço",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sales_url}}/vehicles/available?page=0&size=100",
              "host": [
                "{{sales_url}}"
              ],
              "path": [
                "vehicles",
                "available"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 - vitrine\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Novo preço do Corolla já está no serviço de venda\", () => {",
                  "    const corolla = pm.response.json().content.find(v => v.id === pm.collectionVariables.get(\"corolla_id\"));",
                  "    pm.expect(Number(corolla.price)).to.eql(118000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Compra (serviço de venda)",
      "description": "Efetua a venda com o CPF do comprador e a data da venda. O veículo fica reservado até o processador de pagamento responder pelo webhook.",
      "item": [
        {
          "name": "Comprar o Corolla",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{sales_url}}/sales",
              "host": [
                "{{sales_url}}"
              ],
              "path": [
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{corolla_id}}\",\n  \"buyerCpf\": \"{{buyer_cpf}}\",\n  \"saleDate\": \"{{today}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 - venda criada\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"corolla_sale_id\", body.id);",
                  "pm.collectionVariables.set(\"corolla_payment_code\", body.paymentCode);",
                  "pm.test(\"Venda aguardando pagamento, com código de pagamento\", () => {",
                  "    pm.expect(body.paymentStatus).to.eql(\"PENDING\");",
                  "    pm.expect(body.paymentCode).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"CPF mascarado na resposta (LGPD)\", () => pm.expect(body.buyerCpf).to.eql(\"***.982.247-**\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Vitrine sem o Corolla (reservado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{sales_url}}/vehicles/available?page=0&size=100",
              "host": [
                "{{sales_url}}"
              ],
              "path": [
                "vehicles",
                "available"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 - vitrine\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Corolla reservado não aparece à venda\", () => {",
                  "    const ids = pm.response.json().content.map(v => v.id);",
                  "    pm.expect(ids).to.not.include(pm.collectionVariables.get(\"corolla_id\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar o Corolla reservado (recusado)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{core_url}}/vehicles/{{corolla_id}}",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "vehicles",
                "{{corolla_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"year\": 2022,\n  \"color\": \"Prata\",\n  \"price\": 1.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409 - serviço de venda recusou a edição\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Motivo informado\", () => pm.expect(pm.response.json().detail).to.include(\"reservado\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
