    {
      "name": "1. Cadastro de veículos (serviço principal)",
      "description": "O serviço principal grava no próprio banco (core_db) e publica o veículo no serviço de venda por HTTP (PUT /internal/vehicles/{id}). Os ids gerados ficam salvos nas variáveis da collection.",
      "item": [
        {
          "name": "Cadastrar Corolla",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{core_url}}/vehicles",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "vehicles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"year\": 2022,\n  \"color\": \"Prata\",\n  \"price\": 120000.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 - veículo cadastrado\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"corolla_id\", body.id);",
                  "pm.test(\"Retorna o veículo com o id gerado\", () => {",
                  "    pm.expect(body.id).to.be.a(\"string\");",
                  "    pm.expect(body.model).to.eql(\"Corolla\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar Onix",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
