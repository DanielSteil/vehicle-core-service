            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Chevrolet\",\n  \"model\": \"Onix\",\n  \"year\": 2023,\n  \"color\": \"Branco\",\n  \"price\": 85000.0\n}",
